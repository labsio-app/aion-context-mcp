POSTGRES_DB=aion
POSTGRES_USER=aion_app
PGSCHEMA=aion_context_mcp

# Production compose mounts /run/secrets/postgres_password from the shared Labsio secret.
# Keep this only if you run against a direct DATABASE_URL locally.
DATABASE_URL=postgresql://aion_app:change-me@db:5432/aion

# Protects Nuxt API writes/reads when set.
NUXT_ADMIN_TOKEN=change-me-ui-token

# Discord OAuth for portal sign-in. Register the exact callback URL in Discord.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://aion-mcp.example.com/api/beta/discord/callback

# Protects the remote MCP endpoint when set.
# OAuth metadata and token signing for the remote MCP endpoint.
# In production, point issuer/resource at the public HTTPS origin.
MCP_OAUTH_ISSUER=https://aion-mcp.example.com
MCP_OAUTH_RESOURCE=https://aion-mcp.example.com
MCP_OAUTH_PASSWORD=change-me-oauth-password
MCP_OAUTH_JWT_SECRET=change-me-long-random-secret
# Optional fallback for clients that do not use Client ID Metadata Documents.
# Use exact redirect URIs, or suffix a value with * to allow a prefix.
MCP_OAUTH_ALLOWED_REDIRECT_URIS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/*
# Release metadata injected by GitHub Actions from the deployed tag.
APP_RELEASE_TAG=v0.1.0
APP_COMMIT_SHA=
MCP_HOST=0.0.0.0
MCP_PORT=3001

# IMPORTANT: origins are hostnames only (no https:// or port), e.g. aion-mcp.example.com,chatgpt.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

# Directory used by the MCP server to write JSONL log files.
MCP_LOG_DIR=/var/log/aion-context-mcp

WORKER_POLL_MS=3000
