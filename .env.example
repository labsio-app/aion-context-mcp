POSTGRES_DB=aion
POSTGRES_USER=aion_app
PGSCHEMA=aion_context_mcp

# Production compose mounts /run/secrets/postgres_password from the shared Labsio secret.
# Keep this only if you run against a direct DATABASE_URL locally.
DATABASE_URL=postgresql://aion_app:change-me@db:5432/aion

# Protects Nuxt API writes/reads when set.
NUXT_ADMIN_TOKEN=change-me-ui-token

# Protects the remote MCP endpoint when set.
# OAuth metadata and token signing for the remote MCP endpoint.
# In production, point issuer/resource at the public HTTPS origin.
MCP_OAUTH_ISSUER=https://aion-mcp.example.com
MCP_OAUTH_RESOURCE=https://aion-mcp.example.com
MCP_OAUTH_PASSWORD=change-me-oauth-password
MCP_OAUTH_JWT_SECRET=change-me-long-random-secret
MCP_HOST=0.0.0.0
MCP_PORT=3001

# IMPORTANT: add the public hostname used by Caddy, e.g. aion-mcp.example.com
MCP_ALLOWED_HOSTS=localhost,127.0.0.1
MCP_ALLOWED_ORIGINS=

WORKER_POLL_MS=3000
